* PROGRAM  FOR  VIEWING PRINT FILE ON SCREEN
SET DELI TO '[]'
SET DELI ON
SET COLOR TO W+/B,W+/R,,GR+/B,G+/RB
CLEA
CLOSE ALL
STOR "SAMPLE-PROGRAMM" TO M_HEAD1  &&REST FROM MAIN ADDI
@ 0,0 TO 24,79 DOUB
SET COLOR TO GR+/R
@ 1,INT((80-LEN(M_HEAD1))/2) SAY M_HEAD1 PICT "@!"
SET COLOR TO W+/B,W+/R,,GR+/B,G+/RB
@ 2,1 TO 2,78 DOUB
@ 4,1 TO 4,78 DOUB
SET COLOR TO GR+/RB
@ 3,16 SAY "ON SCREEN DISPLAY OF *.OUT / *.PRN / *.TXT FILES"
SET COLOR TO W+/B,W+/R,,GR+/B,G+/RB
DECLARE ARRAY_DIR[75]
NUM_FILES = ADIR(ARRAY_DIR,"*.TXT")
IF NUM_FILES = 0
   @ 12,12 SAY "NO. FILES FOR DISPLAY...PRESS ANY KEY..."
   UX=INKEY(0)
   CLEA
   CLOS ALL
   RETURN
ENDIF   
DECLARE FILE_NAME[NUM_FILES]
=ADIR(ARRAY_DIR,"*.TXT")
DUMMY = " "
=ADIR(FILE_NAME,"*.TXT")
DO WHILE .T.
   SET COLOR TO W+/B,W+/R,,GR+/B,G+/RB
   @ 5,1 CLEA TO 23,78
   SET COLOR TO W+/G
   @ 5,5 SAY "SELECT PREVIOUSLY STORED OUT FILE FROM : "
   @ 7,8 SAY "MOVE TO THE REQUIRED OUT-FILE AND PRESS ENTER OR 'ESC' TO QUIT"
   SET COLOR TO W+/B,W+/R,,GR+/B,G+/RB
   @ 8,2 TO 21,78 DOUB
   CHO = 0
   CL = 3
   RW=9
   PSIZ = 12
   FOR I = 1 TO NUM_FILES
      @ RW,CL PROMPT M_PAD(FILE_NAME[I,1],PSIZ)
      IF RW <= 19
         RW = RW+1
      ELSE
         RW = 9
         CL = CL + 18
      ENDIF
   NEXT
   MENU TO CHO
   IF LASTKEY() = 27
      CLOSE ALL
      EXIT
   ENDIF
   SELFIL = FILE_NAME[CHO,1]
   IF ! FILE('&SELFIL')
      @ 23,1 SAY "NO SUCH FILE ...PRESS ENTER TO QUIT"
      READ
      CLOSE ALL
      LOOP
   ENDIF
   SAVE SCREEN TO BRSCR1
   SET COLOR TO W+/B,W+/R,,GR+/B,G+/RB
   @ 23,5 SAY "PRESS ENTER TO VIEW THE SELECTED FILE : "+SELFIL
   =INKEY(0)
   ! BROWSE &SELFIL
   @ 23,1 SAY SPACE(77)
   REST SCREEN FROM BRSCR1
   RELEASE BRSCR1
   LOOP
ENDDO
CLOSE ALL
STOR " " TO ASKYN
SET COLOR TO GR+/R
@ 23,12 SAY "DELETE ALL 'OUT FILES' SHOWN ABOVE ? SAY Y/N : " GET ASKYN PICT "!" VALID ASKYN $ "YN"
SET COLOR TO W+/B,W+/R,,GR+/B,G+/RB
READ
@ 23,1 SAY SPACE(77)
IF ASKYN = "Y"
   ! DEL *.TXT
ENDIF
CLEA   
RETURN
*
FUNCTION M_PAD 
PARAM USTRNG,SIZ
Z=ALLTRIM(USTRNG)
X=Z+SPACE(SIZ-LEN(Z))
RETURN(X)
