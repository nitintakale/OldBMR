SELE E
USE CPKG_MST
SET EXCLUSIVE ON
INDE ON ITEM TAG SRPKG
SET EXCLUSIVE OFF
USE
GFILE=ALLTRIM(BGR)+ALLTRIM(EPS)+".DBF"
SELE F
USE CPKG_MST ORDER SRPKG
SELE G
USE &GFILE
GO TOP
DO WHILE .NOT. EOF()
   SELE F
   GO TOP
   SEEK G->PM
   REPL F->SR WITH G->SR
   repl f->pkval with g->pkval
   SELE G
   SKIP
ENDDO
 SELE F
 USE
 USE CPKG_MST EXCLU
 DELE ALL FOR SR=0
 DELE ALL FOR STATUS#"Y"
 INDE ON SR TAG SRCPKG
 USE
 SELE G
 USE

   