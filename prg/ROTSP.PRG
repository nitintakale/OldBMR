****TO CHANGE ROT_SP KEY
ROT_SP=' '
*vbno='ZD7469'
CLEA
DO WHILE .T.
@4,5 SAY 'ENTER BATCH NO:' GET VBNO PICT '!!!!!!'
READ
IF VBNO=SPACE(6)
    RETU
ENDIF	 
DO PROC_3
!CD\DBASE\BMR\&VDIR
SELE A
USE BATCH_NO
GO TOP
LOCATE FOR BATCHNO=VBNO
IF .NOT. FOUND()
    @23,1 SAY 'THIS BATCH NO IS NOT FOUND'
    WAIT
    !CD..
    CLEA
    LOOP
ENDIF
@6,2 CLEA TO 18,77
@6,2 to 13,77 double
@6,3 SAY 'B.SIZE            NAME                  WASHING KEY'
@8,3 SAY A->BAT_SIZE
@8,10 SAY A->NAME1
@8,25 SAY A->NAME2
@8,50 SAY A->ROTSP
CYN=' '
@10,50 SAY '[C] TO CHANGE ' GET CYN PICT '!'
read
IF CYN='C'
   @8,50 GET ROT_SP PICT '!' VALID ROT_SP $('R#S')
   READ  
   YN=' '
   @12,50 SAY '[C] TO CONFIRM' GET YN PICT '!'
   READ
   IF YN='C'
      REPL A->ROTSP WITH ROT_SP
   ENDIF   
ENDIF
EXIT
ENDDO
!CD..