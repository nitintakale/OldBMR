**TO DISPLAY TO_DATE IF NOT VALID TODAYS ONWARDS
clea
sele D
use pkg_mst
set filt to (NAME1=SNAME .AND. NAME2=SNAME1) .AND. (TO_DATE<DATE())  .AND. (STATUS='Y')
GO TOP
IF .NOT. EOF()
    CLEA
    LN=1
    TEXT
    FOR FOLLOWING PRODUCT CONDITION FOR TO_DATE IS NOT VALID FOR TODAY 
 
    AND ONWARDS. ALL SUCH CODENOS WILL BE DISPLAYED BLANK IN BPR.
 
    YOU HAVE TO SELECT MODIFICATION OF FILE OPTION AND CHANGE TO_DATE
    
    ENDTEXT
    LN=8
    @LN,1 SAY REPLI('_',77)
    LN=LN+1
    @LN,1 SAY 'NAME'
    @LN,30 SAY 'ITEM'
    @LN,45 SAY 'CODE'
    @LN,55 SAY 'FROM_DATE'
    @LN,67 SAY 'TO_DATE'
    LN=LN+1
    @LN,1 SAY REPLI('_',77)
    LN=LN+1
   DO WHILE .NOT. EOF()
       @LN,1 SAY NAME1
       @LN,10 SAY NAME2
       @LN,30 SAY ITEM
       @LN,45 SAY CODE
       @LN,55 SAY FR_DATE
       @LN,67 SAY TO_DATE
       LN=LN+1
       SKIP
ENDDO
VCH=' '
LN=23
@LN,1 SAY '[C] TO CHANGE ' GET VCH PICT '!'
READ
IF VCH='C'
      DO bmrmenu
ENDIF    
ENDIF && IF .NOT. EOF()
SELE D
USE
