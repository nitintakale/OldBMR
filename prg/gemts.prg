**PRG TO PRINT SINGLE PAGE
CLEA
DO WHILE .T.
@5,5 SAY 'ENTER BATCH NO:' GET VBNO PICT '!!!!!!'
READ
IF VBNO=SPACE(6)
    RETU
ENDIF	 
DO PROC_3
!CD\DBASE\BMR\&VDIR
SELE C
USE BATCH_NO
GO TOP
LOCATE FOR BATCHNO=VBNO
IF .NOT. FOUND()
    @23,1 SAY 'THIS BATCH NO IS NOT FOUND'
    WAIT
    !CD..
    CLEA
	 LOOP
ENDIF
IF NAME1#SNAME 
     @23,1 SAY 'THIS BATCH NO AND PRODUCT DO NOT MATCHES'
     WAIT 
     !CD..
     CLEA
  	  LOOP
ENDIF
BSIZE=C->BAT_SIZE
VEXPDATE=C->EXPDATE
VMFGDATE=C->MFGDATE
ROT_SP=C->ROTSP
EXIT
ENDDO
!CD..
DO geSIPA
DO WHILE .T.
   DO PRINTOPT
VgePA=SPACE(8)
DO WHILE SPAGE<=EPAGE
    VgePA='gePA'+LTRIM(STR(SPAGE))
    DO &VgePA
    SPAGE=SPAGE+1
    IF SPAGE>EPAGE
       EXIT
    ENDIF
ENDDO	
SET PRINT OFF
SET DEVI TO SCREEN
SET PRINTER TO
yn=' '
CLEA
@22,1 SAY 'ENTER [C] TO CONTINUE FOR SINGLE PAGE BMR' GET YN PICT '!'
READ
IF YN='C'
   CLEA
  DO STA_END.PRG
   @22,1 SAY SPACE(78)
   LOOP
ENDIF	
EXIT
ENDDO
retu