SELE A
USE PKG_MST ORDER ORDBAT
SET FILT TO CATEGORY="E"
GO TOP
*BROW
SET TALK ON
SET STEP ON
SET ECHO ON
SELE B
USE BPRDATA 
SET FILT TO KEY="E"
GO TOP
DO WHILE .NOT. EOF()
    SELE A
    GO TOP
    SET FILT TO A->CIPORDNO=B->CIPORDNO .AND. ALLTRIM(A->BATCH)=ALLTRIM(B->BATCHNO)
    GO TOP
IF .NOT. EOF()
    SELE A
    REPL ALL A->BPRSRNO WITH   B->BPRSRNO
ENDIF
    SELE B
    SKIP
ENDDO   



