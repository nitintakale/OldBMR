
**PRG TO PRINT SINGLE PAGE

CLEA
DO WHILE .T.
@5,5 SAY 'ENTER BATCH NO:' GET VBNO PICT '!!!!!!'
READ
IF VBNO=SPACE(6)
    RETU
ENDIF	 
DO PROC_3
!CD\DBASE\BMR\&VDIR
SELE A
USE BATCH_NO
GO TOP
LOCATE FOR BATCHNO=VBNO
IF .NOT. FOUND()
    @23,1 SAY 'THIS BATCH NO IS NOT FOUND'
    WAIT
    !CD..
    CLEA
	 LOOP
ENDIF
IF NAME1#SNAME 
     @23,1 SAY 'THIS BATCH NO AND PRODUCT DO NOT MATCHES'
      WAIT
     !CD..
     CLEA 
  	  LOOP
ENDIF
BSIZE=A->BAT_SIZE
VEXPDATE=A->EXPDATE
VMFGDATE=A->MFGDATE
ROT_SP=A->ROTSP
EXIT
ENDDO
!CD..
DO CISIPAGE
DO WHILE .T.
store 0 to spage,epage
DO WHILE .T.
@7,5 say 'START PAGE NO :' GET SPAGE PICT '99'
@9,5 say 'END PAGE NO   :' GET EPAGE PICT '99'
READ
    IF SPAGE=0 .OR. EPAGE=0
       LOOP
    ELSE
       EXIT
    ENDIF	
ENDDO
DO PRINTOPT
VCIMAPA=SPACE(8)
DO WHILE SPAGE<=EPAGE
    VCIMAPA='CIMAPA'+LTRIM(STR(SPAGE))
    DO &VCIMAPA
    SPAGE=SPAGE+1
    IF SPAGE>EPAGE
       EXIT
    ENDIF
ENDDO	
eject
SET PRINT OFF
SET DEVI TO SCREEN
SET PRINTER TO
yn=' '
CLEA
@22,1 SAY 'ENTER [C] TO CONTINUE FOR SINGLE PAGE BMR' GET YN PICT '!'
READ
IF YN='C'
   @22,1 SAY SPACE(78)
   LOOP
ENDIF	
EXIT
ENDDO
RETU