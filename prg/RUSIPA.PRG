**PRG FOR LOCATE BATCHNO FOR SINGLE PAGE
IF SPAGE>1
DO PRINTOPT
VBPA=SPACE(5)
DO WHILE SPAGE<=EPAGE
    VBPA='RUPA'+LTRIM(STR(SPAGE))
    DO &VBPA
    SPAGE=SPAGE+1
    IF SPAGE>EPAGE
       EXIT
    ENDIF
ENDDO	
ENDIF
IF SPAGE=1
	LN=13
    RM=BSIZE*1000/VOLVIAL
    RM=RM-50
    RM=ROUND(RM,-2)
IF VPS#'Y'&& for not different sample
    STORE 0 TO RRM
    DO PRINTOPT
    N=1
DO WHILE N<=5
    N=LTRIM(STR(N))
    VQT=SPACE(3)
    VQT='QT'+N
    IF &VQT=0
	    N=VAL(N)
		 N=N+1
       LOOP
    ENDIF      				 
    IF &VQT#0
       RRM=&VQT 
    ENDIF	
IF VAL(N)=4
    PG1=1.04*(RRM+RRM/VOUTCART) 
    PG2=1.03*RRM
    PG3=0
    PG4=(1.01*RRM)+50
    PG5=(1.01)*(RRM/VOUTCART)+0.5
    PG6=1.02*(RRM/VSHIP)+0.5
    PG7=1.01*RRM
    PG1=(PG1/500)+0.5
    PG1=ROUND(PG1,0)
	 PG1=PG1*500
    PG2=PG2+50
    PG2=ROUND(PG2,-2)/10
    PG4=ROUND(PG4,-2)/10
    PG5=ROUND(PG5,-1)
    PG6=ROUND(PG6,0)
    PG7=ROUND(PG7,-2)/10
ENDIF
IF VAL(N)=1 .OR.VAL(N)=2 .OR.VAL(N)=3 .OR.VAL(N)=5 
    PG1=1.04*(RRM+RRM/VOUTCART) 
    PG2=1.03*RRM
    PG3=0
    PG4=(1.01*RRM)+50
    PG5=(1.01)*(RRM/VOUTCART)+0.5
    PG6=1.02*(RRM/VSHIP)+0.5
    PG7=1.01*RRM
    PG1=(PG1/500)+0.5
    PG1=ROUND(PG1,0)
	 PG1=PG1*500
    PG2=PG2+50
    PG2=ROUND(PG2,-2)/5
    PG4=ROUND(PG4,-2)/5
    PG5=ROUND(PG5,-1)
    PG6=ROUND(PG6,0)
    PG7=ROUND(PG7,-2)/5
ENDIF
    DO RUPA1
    N=VAL(N)
	 N=N+1    
 ENDDO
ENDIF
IF VPS='Y' && for sample only
    STORE 0 TO RRM
    DO PRINTOPT
    N=4
    N=LTRIM(STR(N))
    VQT=SPACE(3)
    VQT='QT'+N
    RRM=&VQT 
    PG1=1.04*(RRM+RRM/VOUTCART) 
    PG2=1.03*RRM
    PG3=0
    PG4=(1.01*RRM)+50
    PG5=(1.01)*(RRM/VOUTCART)+0.5
    PG6=1.02*(RRM/VSHIP)+0.5
    PG7=1.01*RRM
    PG1=(PG1/500)+0.5
    PG1=ROUND(PG1,0)
    PG1=PG1*500
    PG2=PG2+50
    PG2=ROUND(PG2,-2)
    PG4=ROUND(PG4,-2)
    PG5=ROUND(PG5,-1)
    PG6=ROUND(PG6,0)
    PG7=ROUND(PG7,-2)
    DO RUPA1
ENDIF
ENDIF
EJECT
SET PRINT OFF
SET DEVI TO SCREEN
SET PRINTER TO
