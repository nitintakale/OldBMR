*****COMMON FOR ALL BPR 
CLEA
VPS='Y'
@15,1 SAY 'ENTER [N] IF SAMPLE  FILL PACKSIZE IS DIFFERENT THAN SALE SIZE' GET VPS PICT '!' VALID VPS='Y' .OR. VPS='N'
READ
CLEA
@1,0 TO 20,50 DOUBLE
DO WHILE .T.
      @3,1 SAY 'ENTER BATCH NO:' GET VBNO PICT '!!!!!!'
      READ
      IF VBNO=SPACE(6)
          !CD\
          CLOSE DATABASES 
          QUIT
      ENDIF	 
      DO PROC_3
      !CD\DBASE\BMR\&VDIR
      SELE C
      USE BATCH_NO
      GO TOP
      LOCATE FOR BATCHNO=VBNO 
      IF BPR='Y'
		   YN=' '
			@23,1 SAY 'BPR IS ALREADY TAKEN OUT CONFIRM [Y/N]' GET YN PICT '!'
			READ
			IF YN#'Y'
			    LOOP
            ENDIF				 
      ENDIF
      IF .NOT. FOUND()
          @23,1 SAY 'THIS BATCH NO IS NOT FOUND'
          !CD..
       	 LOOP
     ENDIF
     IF (C->NAME1#SNAME)  .OR. (C->NAME2#SNAME1)
          @23,1 SAY 'THIS BATCH NO AND PRODUCT DO NOT MATCHES'
          !CD..
       	  LOOP
     ENDIF
          BSIZE=C->BAT_SIZE
          VEXPDATE=C->EXPDATE
          VMFGDATE=C->MFGDATE
          EXIT
     ENDDO
         @2,1 SAY PNAME
         @4,1 say 'EXPDATE:=' GET VEXPDATE
         READ
LN=6
IF AS='A' .OR. (AS='S' .AND. SPAGE=1)
IF VPS='Y'
    LN=LN+2
    @LN,1 SAY 'QTY FOR EXPORT1' GET QT1 PICT '999999'
    READ
    LN=LN+2
    @LN,1 SAY 'QTY FOR EXPORT2' GET QT2 PICT '999999'
    READ
    LN=LN+2
    @LN,1 SAY 'QTY FOR EXPORT3' GET QT3 PICT '999999'
    READ
    LN=LN+2
    @LN,1 SAY 'QTY FOR (P.S.) ' GET QT4 PICT '999999'
    READ
ENDIF
    IF VPS='N'
	    LN=LN+2
	    @LN,1 SAY 'QTY FOR EXPORT1' GET QT1 PICT '999999'
    	READ
	    LN=LN+2
	    @LN,1 SAY 'QTY FOR EXPORT2' GET QT2 PICT '999999'
	    READ
	    LN=LN+2
	    @LN,1 SAY 'QTY FOR EXPORT3' GET QT3 PICT '999999'
	    READ
    ENDIF
    LN=LN+2
