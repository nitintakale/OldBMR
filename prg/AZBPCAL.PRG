!CD\DBASE\BMR
SELE B
USE PRODMAST
GO TOP
LOCATE FOR NAME1=SNAME .AND. NAME2=SNAME1
SELE A
use pkg_mst
GO TOP
LOCATE FOR NAME1=SNAME .AND. NAME2=SNAME1 .AND. ITEM='ENCLOSURE' 
IF FOUND()
  CLEA
  @15,5 SAY ' ENTER [Y] FOR ENCLOSURE IN SALE/SAMPLE' GET ENC PICT '!'
  READ
 ENDIF
	VOUTCART=B->OUTCARTVAL
	VSHIP=B->SHIPPERVAL
	YIELD=B->YIELD
	CLEA
	@10,1 TO 17,60 DOUBLE
	@11,4 SAY ' NO OF OUTER CARTONS IN ONE SHIPPER:' GET VOUTCART PICT '9999'
	@13,4 SAY ' TOTAL NO OF VIALS IN ONE SHIPPER      :' GET VSHIP  PICT '9999'
	READ
	RM=BSIZE*1000/VOLVIAL
	RM=RM-50
	RM=ROUND(RM,-2)
	QT5=((YIELD/100)*RM)-(QT1+QT2+QT3+QT4)
	@15,4 SAY 'QTY FOR SALE  ' 
	@15,19 GET QT5 PICT '9999999'
	READ
ENDIF
