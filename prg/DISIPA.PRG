**PRG FOR SINGLE PAGE BPR BECLATE/BUDANESE
IF SPAGE>1
     CLEA 
     DO PRINTOPT
     VDIPA=SPACE(5)
    DO WHILE SPAGE<=EPAGE
       VDIPA='DIPA'+LTRIM(STR(SPAGE))
       DO &VBPA
       SPAGE=SPAGE+1
       IF SPAGE>EPAGE
           EXIT
       ENDIF
    ENDDO	
ENDIF
IF SPAGE=1
    SELE A
    USE PRODMAST
    GO TOP
    LOCATE FOR NAME1=SNAME .AND. NAME2=SNAME1
    VOUTCART=A->OUTCARTVAL
    VSHIP=A->SHIPPERVAL
    YIELD=A->YIELD
    SELE B
    use pkg_mst
    LN=13
    RM=BSIZE*1000/VOLVIAL
    RM=RM-50
    RM=ROUND(RM,-2)
IF VSAMP#'Y'&& for not different sample
    QT5=((YIELD/100)*RM)-(QT1+QT2+QT3+QT4)
    @LN,1 SAY 'QTY FOR SALE  ' 
    @LN,15 SAY QT5 PICT '9999999'
    WAIT
    STORE 0 TO RRM
    DO PRINTOPT
    N=1
 DO WHILE N<=5
    N=LTRIM(STR(N))
    VQT=SPACE(3)
    VQT='QT'+N
    IF &VQT=0
	    N=VAL(N)
		 N=N+1
       LOOP
    ENDIF      				 
    IF &VQT#0
       RRM=&VQT 
    ENDIF	
    PG1=1.04*(RRM+RRM/VOUTCART) 
    PG2=1.03*RRM
    PG3=0
    PG4=(1.01*RRM)+50
    PG5=(1.01)*(RRM/VOUTCART)+0.5
    PG6=1.02*(RRM/VSHIP)+0.5
    PG7=1.01*RRM
    PG1=(PG1/500)+0.5
    PG1=ROUND(PG1,0)
	 PG1=PG1*500
    PG2=PG2+50
    PG2=ROUND(PG2,-2)
    PG4=ROUND(PG4,-2)
    PG5=ROUND(PG5,-1)
    PG6=ROUND(PG6,0)
    PG7=ROUND(PG7,-2)
    DO BPA1
    N=VAL(N)
	 N=N+1
ENDDO
ENDIF
IF VSAMP='Y' && for sample only
    QT4=((YIELD/100)*RM)
    @LN,1 SAY 'QTY FOR SAMPLE  ' 
    @LN,15 SAY QT4 PICT '9999999'
    WAIT
    STORE 0 TO RRM
    DO PRINTOPT
    N=4
    N=LTRIM(STR(N))
    VQT=SPACE(3)
    VQT='QT'+N
    RRM=&VQT 
*PG1=LABEL
*PG2=INNER PRINT.CART
*PG3=
*PG4=ENCLOSURE
*PG5=OUTER CARTONS
*PG6=OUTER CORRU BOXES
*PG7=NASAL ADAPTOR
*PG8=BOPP FILM
    PG1=1.04*(RRM+RRM/VOUTCART) 
    PG2=1.03*RRM
    PG3=0
    PG4=(1.01*RRM)+50
    PG5=(1.01)*(RRM/VOUTCART)+0.5
    PG6=1.02*(RRM/VSHIP)+0.5
    PG7=1.01*RRM
    PG1=(PG1/500)+0.5
    PG1=ROUND(PG1,0)
	 PG1=PG1*500
    PG2=PG2+50
    PG2=ROUND(PG2,-2)
    PG4=ROUND(PG4,-2)
    PG5=ROUND(PG5,-1)
    PG6=ROUND(PG6,0)
    PG7=ROUND(PG7,-2)
    DO DIPA1
ENDIF
ENDIF
    EJECT
    SET PRINT OFF
    SET DEVI TO SCREEN
    SET PRINTER TO
    RETU
