
SET DEVI TO SCREEN
close data
set proc to adihead
do adistart
SET DELE ON
CLEA
*--------------------------*
CLOS DATA
DELE FILE USERPASS.IDX
DELE FILE MENUOPT.IDX
DELE FILE USERIGHT.IDX
USE USERPASS 
INDE ON USER TO USERPASS
USE MENUOPT
*INDE ON MAINOPT+SUBOPT TO MENUOPT
INDE ON OPT_KEY TO MENUOPT
USE USERIGHT
INDE ON USER+MAINOPT+SUBOPT TO USERIGHT
CLOS DATA
*--------------------------*
PUBLIC USERNAME
STOR SPACE(8) TO USERNAME
PERMIT = .F.
IF ! CHECKPS(PERMIT)
   SET COLOR TO W+/G
   @ 23,12 SAY "SORRY...UNAUTHORISED PERSON...PRESS ANY KEY.."
   SET COLOR TO W+/B,W+/R
   READ VALID LASTKEY()#27
   CLOSE DATA
   @ 13,0 CLEA
   RETURN
ENDIF   
@ 0,0 CLEA
DO npmenu
RETU
*----------------*
FUNCTION CHECKPS
PARAM PERMIT
SAVE SCREEN TO PASSCR
SELE H
USE USERPASS INDE USERPASS
STOR 0 TO UNT
@ 0,0 FILL TO 24, 78 COLOR GR+/RB
DO WHILE UNT < 3
   STOR SPACE(8) TO USERNAME
   STOR SPACE(10) TO USERPW
   STOR SPACE(1) TO LEVL
   STOR 0 TO LEV1
   SET COLOR TO W+/B,W+/R
   @ 3,1 CLEA TO 23,78
   SET COLOR TO W+/B,W+/R,,BG/N,W+/RB
   @ 3,20,12,60 BOX "ллллллллА"
   SET COLOR TO GR+/R
   @ 4,25 SAY "WELCOME TO ADITI PHARMACEUTICALS" 
   @ 5,30 SAY "B.M.R /B.P.R -SYSTEM" 
   SET COLOR TO W+/RB,W+/R
   @ 8,26 SAY "ENTER USER NAME : " 
   @ 10,26 SAY "ENTER PASS-WORD : " 
   @ 8,44 GET USERNAME PICT "@!"
   SET COLOR TO W+/B,W+/R
   READ VALID LASTKEY()=13
   @ 23,1 SAY SPACE(77)
   IF LASTKEY() = 27 .OR. USERNAME=SPACE(8)
      PERMIT = .F.
      REST SCREEN FROM PASSCR
      RELEASE PASSCR
      RETURN(PERMIT)
   ENDIF
   STOR UNT+1 TO  UNT
   @ 12,62 SAY "TRAIL # : "+STR(UNT,1,0)
   SELE H
   LOCATE FOR USER= USERNAME
   IF .NOT. FOUND()
      SET COLOR TO W+/B,W+/R
      @ 23,1 SAY SPACE(77)
      IF UNT < 3
         SET COLOR TO W+/RB
         @ 23,9 SAY "THIS IS NOT REGISTERED USER.... TRY AGAIN..."
         SET COLOR TO W+/B,W+/R
         UX=INKEY(0)
         @ 23,1 SAY SPACE(77)
         LOOP
      ENDIF 
      SET COLOR TO W+/RB
      @ 23,12 SAY "MORE THAN 3 TRAILS...U R NOT REGISTERED USER.... QUITING......"
      SET COLOR TO W+/B,W+/R
      UX=INKEY(0)
      @ 23,1 SAY SPACE(77)
      PERMIT = .F.
      REST SCREEN FROM PASSCR
      RELEASE PASSCR
      RETURN(PERMIT)
   ENDIF
   STOR H->PASSWORD TO USERPW
   STOR H->FULL_NAME TO UFULNAM
   STOR H->LEVEL TO LEV1
   @ 10,44 SAY " "
   SET CONSOLE OFF
   STOR "" TO P
   STOR " " TO TW1,TW2,TW3,TW4,TW5,TW6,TW7,TW8,TW9,TW10
   CNT =1
   ACCEPT TO P
   P=LOWER(P)
   SET CONSOL ON
   B=LEN(P)
   DO WHILE CNT<=B
      CNTR = ALLTRIM(STR(CNT,2,0))
      STOR SUBSTR(P,CNT,1) TO TW&CNTR
      CNT=CNT+1
   ENDDO
   SET CONSOLE ON
   A = 70
   B = 10
   WORD = CHR(ASC(TW1)+A-1)+CHR(ASC(TW2)+B+1)+;
   CHR(ASC(TW3)+A-2)+CHR(ASC(TW4)+B+2)+CHR(ASC(TW5)+A-3)+;
   CHR(ASC(TW6)+B+3)+CHR(ASC(TW7)+A-4)+;
   CHR(ASC(TW8)+B+4)+CHR(ASC(TW9)+A-5)+CHR(ASC(TW10)+B+5)
   IF WORD = USERPW
      SET COLOR TO GR+/R
      @ 14,26 SAY "WEL-COME "
      @ 15,26 SAY "PASS WORD ACCEPTED...FOUND OK!..."
      @ 16,26 SAY "PERMISSION GRANTED TO OPERATE ! "
      SET COLOR TO W+/G
      @ 14,37 SAY ALLTRIM(UFULNAM)
      @ 17,26 SAY "PRESS ANY KEY FOR MAIN MENU..."
      SET COLOR TO W+/B,W+/R
      PERMIT = .T.
      UX=INKEY(0)
      EXIT
   ELSE
      SET COLOR TO W+/B,W+/R
      @ 23,1 SAY SPACE(77)
      IF UNT < 3
         SET COLOR TO W+/RB
         @ 14,26 SAY "NO SUCH PASS-WORD FOR THIS USER.."
         SET COLOR TO B/BG
         @ 16,26 SAY "...........TRY AGAIN............."
         @ 17,26 SAY "         PRESS ANY KEY           "
         UX=INKEY(0)
         SET COLOR TO W+/B,W+/R
         @ 23,1 SAY SPACE(77)
         LOOP
      ENDIF 
      SET COLOR TO W+*/G
      @ 14,26 SAY "PASS WORD UNKNOWN ..............."
      SET COLOR TO B/BG
      @ 16,26 SAY "SORRY !!!...MORE THAN 3 TRIALS.. "
      @ 17,26 SAY "       PRESS ANY KEY             "
      PERMIT = .F.
      SET COLOR TO W+/B,W+/R
      UX=INKEY(0)
      EXIT
   ENDIF
ENDDO
SELE H
USE
REST SCREEN FROM PASSCR
RELEASE PASSCR
RETURN(PERMIT)
*----------------*
