**** NO OF BATCHES UNPACKED AS ON entered date
****BATCHES MANUFACTURED BUT NOT PACKED STATMENT
SET PROC TO ADIHEAD
DO ADISTART
set printer to
STORE CTOD('  /  /    ') TO ENDATE
close data
clea
@15,1 SAY 'ENTER LAST DATE(UPTO DATE):' get endate pict 'd'
read
IF ENDATE=CTOD('  /  /    ') 
  RETU
ENDIF  
SELE A
USE BATCH_NO ORDER BN12
GO TOP
COPY TO BTEMP FOR  (MIX_DATE<=ENDATE .AND. MIX_DATE#CTOD('  /  /    ')) .AND. (SUBSTR(BATCHNO,1,2)#'BM') .AND. ((COMPLETE=' ') .OR. (COMPLETE='C'.AND. PACK_DATE>ENDATE)) 
SELE A
USE
SELE A
USE BTEMP
GO TOP
SELE B
USE PACKQTY
SELE C
USE PRODMAST
SELE D
USE FUNPACK EXCLUSIVE
ZAP
LN=5
SELE B
GO TOP
VVCODE=SPACE(5)
SELE A
DO WHILE .NOT. EOF()
  VCODE=A->CODE
  SELE B
  GO TOP
  SET FILT TO B->BATCHNO=A->BATCHNO
  GO TOP
  PQTY=0
  DO WHILE .NOT. EOF()
    IF PACK_DATE<=ENDATE
      PQTY=PQTY+B->PACK_QTY
    ENDIF 
      SKIP
     ENDDO
  SELE C
  SET FILT TO C->CODE=VCODE
  YQTY=0
  YQTY=A->BAT_QTY*C->YIELD/100
  IF PQTY>YQTY  
      CLEA
      @1,1 SAY 'FOR FOLLOWING PRODUCTS PACK_QTY > BSR_QTY'
      @2,1 SAY 'BATCH              TOTAL QTY PACKED     BSR QTY'
      @5,1 SAY A->BATCHNO
      @5,25 SAY PQTY PICT '9999999'
      @5,45 SAY YQTY PICT '9999999'
      @22,2 SAY '...............PRESS ANY KEY TO CONTI..'
      =INKEY(0)
 ENDIF    
      SELE D
      STOR " " TO GOOUT
   DO WHILE .T.
      APPE BLANK
  IF RLOCK()
      REPL CODE WITH VCODE
      REPL UNPACKQTY WITH (A->BAT_QTY)-PQTY
      REPL BATCHNO WITH A->BATCHNO
      REPL NAME WITH TRIM(A->NAME1)+'  '+TRIM(A->NAME2)  
      REPL BAT_SIZE WITH A->BAT_SIZE
      REPL MFGDATE WITH A->MFGDATE
      FLUSH
      UNLOCK
      EXIT  
  ELSE
      STOR " " TO GOOUT 
      DO ER_RLOC 
  ENDIF
 EXIT
 ENDDO


SELE A
SKIP
IF EOF()
   EXIT
ENDIF   
ENDDO
CLOSE DATA
SELE A
USE FUNPACK exclu
inde on name to unnm
sele a
use
sele a 
use  funpack inde unnm
GO TOP
SELE B
USE BATCH_NO
DO PRINTOPT
IF OPT=0
   RETU
ENDIF   
LN=1
SR=1
@LN,10 SAY 'ADITI PHARMACEUTICALS PVT. LTD.'
LN=LN+1
@LN,14 SAY 'E-65/66 MIDC. SOLAPUR-413006'
LN=LN+2
@LN,1 SAY 'BATCHES MANUFACTURED BUT NOT PACKED AS ON '+'  '+LTRIM(DTOC(ENDATE))
LN=LN+1
EE=REPL('-',150)
@LN,1 SAY CHR(15)
@LN,1 SAY EE
LN=LN+1
@LN,1 SAY 'SR NO.'
@LN,9 SAY 'PRODUCT'
@LN,49 SAY 'BATCH NO'
@LN,59 SAY 'BATCH SIZE'
@LN,72 SAY 'MFG.DT'
@LN,85 SAY 'QTY. TO BE PACKED'
@LN,110 SAY 'REMARKS'
ln=ln+1
@ln,1 say ee
ln=ln+1
SELE A
DO WHILE .NOT. EOF()
   @LN,1 SAY SR PICT '999'
   @LN,7 SAY NAME
   @LN,51 SAY BATCHNO
   @LN,59 SAY LTRIM(STR(BAT_SIZE))+' '+'LTS'
   @LN,72 SAY MFGDATE
*   @LN,85  SAY BSR_QTY
   @ln,85 say UNPACKQTY
   LN=LN+2
   SR=SR+1
 SKIP
   IF EOF()
      EXIT
   ENDIF
   IF LN>64
      EJECT   
      LN=3
      @LN,1 SAY EE
      LN=LN+1
      @LN,1 SAY 'SR NO.'
      @LN,9 SAY 'PRODUCT'
      @LN,49 SAY 'BATCH NO'
      @LN,59 SAY 'BATCH SIZE'
      @LN,72 SAY 'MFG.DT'
      @LN,85 SAY 'QTY. TO BE PACKED'
      @LN,110 SAY 'REMARKS'
      LN=LN+1
      @LN,1 SAY EE
      LN=LN+1
   ENDIF
   ENDDO      
   @LN,1 SAY CHR(18)
   EJECT
   SET PRINT OFF
   SET DEVI TO SCREEN
   SET PRINTER TO
   **** bank statment for NO OF BATCHES UNPACKED AS ON TODAY
SELE A
GO TOP
BANK=' '
CLEA
@15,5 SAY '[B] FOR BANK STATMENT:-' GET BANK PICT '!'
READ
IF BANK='B'
    DO PRINTOPT
    LN=1
    SR=1
    @LN,10 SAY 'ADITI PHARMACEUTICALS PVT. LTD.'
    LN=LN+1
    @LN,14 SAY 'E-65/66 MIDC. SOLAPUR-413006'
    LN=LN+2
    @LN,25 SAY 'WIP AS ON '+'  '+LTRIM(DTOC(ENDATE))
    LN=LN+1
    @LN,1 SAY CHR(15)
    @LN,1 SAY EE
    LN=LN+1
    @LN,1 SAY 'SR NO.'
    @LN,9 SAY 'PRODUCT'
    @LN,49 SAY 'BATCH NO'
    @LN,59 SAY 'BATCH SIZE'
    @LN,72 SAY 'MFG.DT'
    @LN,85 SAY 'QTY. TO BE PACKED'
    @LN,110 SAY 'RATE'
    @LN,120 SAY 'AMOUNT'
    STORE 0 TO VAMOUNT
    ln=ln+1
    @ln,1 say ee
    ln=ln+1
    SELE A
DO WHILE .NOT. EOF()
       @LN,1 SAY SR PICT '999'
       @LN,7 SAY NAME
       @LN,51 SAY BATCHNO
       @LN,59 SAY LTRIM(STR(BAT_SIZE))+' '+'LTS'
       @LN,72 SAY MFGDATE
       @LN,85  SAY A->UNPACKQTY
       SELE B
       GO TOP
       LOCATE FOR BATCHNO=A->BATCHNO
        AMOUNT=B->CONVRATE*A->UNPACKQTY
        @LN,110 SAY B->CONVRATE PICT '99.99'
        @LN,120 SAY AMOUNT PICT '9999999.99'
        VAMOUNT=VAMOUNT+AMOUNT
        LN=LN+2
        SR=SR+1
   SELE A
   SKIP
   IF EOF()
      EXIT
   ENDIF
   IF LN>64
      EJECT   
      LN=3
      @LN,70 SAY 'CONTI....'
      LN=LN+1
      @LN,1 SAY EE
      LN=LN+1
      @LN,1 SAY 'SR NO.'
      @LN,9 SAY 'PRODUCT'
      @LN,49 SAY 'BATCH NO'
      @LN,59 SAY 'BATCH SIZE'
      @LN,72 SAY 'MFG.DT'
      @LN,85 SAY 'QTY. TO BE PACKED'
      @LN,110 SAY 'RATE'
      @LN,120 SAY 'AMOUNT'
      LN=LN+1
      @LN,1 SAY EE
      LN=LN+1
   ENDIF
 ENDDO      
   LN=LN+1
   @LN,1 SAY EE
   LN=LN+1
   @LN,120 SAY VAMOUNT PICT '99999999.99'
   @LN,1 SAY CHR(18)
   EJECT
   SET PRINT OFF
   SET DEVI TO SCREEN
   SET PRINTER TO
ENDIF
   CLOSE DATA
      