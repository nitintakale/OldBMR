DO WHILE .T.
     SET COLOR TO W+/B,W+/R
     CLEA
     STORE 0 TO RCHON3
     STORE SPACE(1)  TO  VPRTYPE,VVCAN,VGR,VCHOICE
     STORE SPACE(9)  TO  PMSR1,PMSR2,PMSR3,PMSR4,PMSR5,PMSR6,PMSR7,PMSR8,PMSR9,PMSR10,PMSR11,PMSR12,PMSR13,PMSR14,PMSR15
     STORE SPACE(12) TO  SE
     STORE SPACE(30) TO  PMDSR1,PMDSR2,PMDSR3,PMDSR4,PMDSR5,PMDSR6,PMDSR7,PMDSR8,PMDSR9,PMDSR10,PMDSR11,PMDSR12,PMDSR13,PMDSR14,PMDSR15
     @ 0,0 TO 24,78 DOUBLE
     @ 1,2 SAY 'SELECT TYPE  FROM FOLLOWING TO ADD/MODIFY SERIAL OF PACKING MATERIAL IN BPR'
     SET COLOR TO W+/B,W+/G
     @12,2 GET RCHON3 FUNCTION '*TH LOCAL SALE ; EXPORT ; P.S.; <ESC> TO EXIT' SIZE 1, 10 DEFAULT 'LOCAL SALE'

   READ CYCLE
    DO CASE
    CASE RCHON3 = 1
       VGR="S"
       SE="SALE"
    CASE RCHON3 = 2
       VGR="E"
       SE ="EXPORT"
    CASE RCHON3 = 3
       VGR="P"
       SE ="PS"
   OTHERWISE
    CLOSE DATA
    EXIT
  ENDCASE
 SELE B
 USE PRTYPE
 SET COLOR TO R+/B,W+/G
 @10,10 CLEA TO 18,60
 DEFINE WINDOW TEMP FROM 10,20 TO 18,50
 DEFINE POPUP S_LIST FROM 10,20 TO 18,50 PROMPT FIELDS LTRIM(KEY)+" "+LTRIM(TYPE)   FOOTER "PRESS [ GO DOWN] [ GO UP]  [ENTER] KEY TO SELECT"   && IN WINDOW TEMP 
 ACTIVATE WINDOW TEMP
 @ 0,0 GET VPRTYPE POPUP S_LIST
 READ VALID LASTKEY() = 13 .OR. LASTKEY() = 27
 DEACTIVATE WINDOW TEMP
 PRODTYPE = B->TYPE
 VPRTYPE= B->KEY
 SELE B
 USE
 
 
