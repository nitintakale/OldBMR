SELE A
USE EXP_DATE
SELE B
USE PRODMAST
SELE A
GO TOP
LOCATE FOR CMONTH=VMFGMON
SELE B
GO TOP
LOCATE FOR B->NAME1=SNAME .AND. B->NAME2=SNAME1
A=A->MONTH+B->EXPIRY-1
B=A/12
C=INT(B)
D=A-(C*12)
IF D#0
   VEXPYEAR=VMFGYEAR+C
   SELE A
   GO TOP
   LOCATE FOR A->MONTH=D
   VEXPMON=A->CMONTH
ENDIF
IF D=0
   VEXPYEAR=VMFGYEAR+C-1 
   VEXPMON='DEC'
ENDIF
VMFGDATE=LTRIM(VMFGMON)+'-'+LTRIM(STR(VMFGYEAR))
VEXPDATE=LTRIM(VEXPMON)+'-'+LTRIM(STR(VEXPYEAR))
do DIcal