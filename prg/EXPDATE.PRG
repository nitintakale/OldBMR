LN=LN+1
DO WHILE .T.
  SELE A
  USE EXP_DATE ORDER CEXPMON
  SEEK VMFGMON
  SELE B
  USE PRODMAST ORDER PN12
  SEEK sname+SNAME1
  A=A->MONTH+B->EXPIRY-1
  B=A/12
  C=INT(B)
  D=A-(C*12)
IF D#0
   VEXPYEAR=VMFGYEAR+C
   SELE A
   GO TOP
   LOCATE FOR A->MONTH=D
   VEXPMON=A->CMONTH
ENDIF
   IF D=0
     VEXPYEAR=VMFGYEAR+C-1 
     VEXPMON='DEC.'
   ENDIF
     @LN,2  SAY 'EXP MONTH            :' + VEXPMON 
     @LN,30 SAY 'EXP YEAR  :'+ LTRIM(STR(VEXPYEAR))
     CLOSE DATA
     VMFGDATE=VMFGMON+LTRIM(STR(VMFGYEAR))
     VEXPDATE=LTRIM(VEXPMON)+LTRIM(STR(VEXPYEAR))
      set color to w+/b,w+/r
     @22,1 clea to 23,78
     set color to w+/g
  	 @22,2 SAY "FOR ANY CHANGE IN EXPDATE PRESS ['ESC'] to try again..."
  	 @23,2 SAY "......else...PRESS ['ENTER'] KEY TO CONTI...."
     READ 
  	 SET COLOR TO W+/B,W+/R
   	 @22,1 clea to 23,78
   IF LASTKEY()=27
     VEXPMON=SPACE(3)
     @LN,24 GET VEXPMON PICT '!!!' VALID VEXPMON$('JANFEBMARAPRMAYJUNJULAUGSEPOCTNOVDEC')
     @LN,41 GET VEXPYEAR PICT '9999'
     READ
     IF LTRIM(VEXPMON) = 'MAY'
        VEXPDATE=LTRIM(VEXPMON)+' '+LTRIM(STR(VEXPYEAR))
     ELSE
        VEXPDATE=LTRIM(VEXPMON)+'.'++LTRIM(STR(VEXPYEAR))
     ENDIF
     EXIT
   ELSE
      EXIT
   ENDIF
   ENDDO      
