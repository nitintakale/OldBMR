****TO BE USED WHEN STRU OF PRTYPE GETS CHANGED
USE FBPRDATA 
COPY TO UV1 STRU EXTE
USE
SELE B
USE FSALE EXCLU
COUNT TO TOTREC
SELE A
USE UV1 EXCLUSIVE
INDE ON FIELD_NAME TO UV1
USE UV1 INDE UV1 
SELE B
GO TOP
DO WHILE .NOT. EOF()
   FLD1=FIELD_NAME
   SELE A
   LOCATE FOR FIELD_NAME = FLD1
IF .NOT. FOUND()
   APPE BLANK
   REPL FIELD_NAME WITH FLD1
   REPL FIELD_TYPE WITH B->FIELD_TYPE
   REPL FIELD_LEN  WITH B->FIELD_LEN
   REPL FIELD_DEC  WITH B->FIELD_LEN
ENDIF
SELE B
SKIP
ENDDO
USE
USE FBPRDATA 
COPY TO UTEMP
USE
CREATE FBPRDATA FROM UV1
USE FBPRDATA 
APPE FROM UTEMP
USE
DELE FILE UTEMP.DBF














DO WHILE CNT < TOTREC
   STOR STR(CNT,1,0) TO CNTR
   STOR "FLD"+CNTR TO UFLD
   SEEK &UFLD
   IF .NOT. FOUND()
      APPE BLANK
      REPL FIELD_NAME WITH &UFLD
      REPL FIELD_TYPE WITH "N"
      REPL FIELD_LEN  WITH 15
      REPL FIELD_DEC  WITH 2
   ENDIF
   CNT = CNT + 1
ENDDO
USE
USE INVNO 
COPY TO UTEMP
USE
CREATE INVNO FROM UV1
USE INVNO 
APPE FROM UTEMP
USE
DELE FILE UTEMP.DBF