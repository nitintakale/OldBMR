**PRG TO PRINT SINGLE PAGE
CLEA
DO WHILE .T.
@5,5 SAY 'ENTER BATCH NO:' GET VBNO PICT '!!!!!!'
READ
IF VBNO=SPACE(6)
    RETU
ENDIF	 
DO PROC_3
!CD\DBASE\BMR\&VDIR
SELE A
USE BATCH_NO
GO TOP
LOCATE FOR BATCHNO=VBNO
IF .NOT. FOUND()
    @23,1 SAY 'THIS BATCH NO IS NOT FOUND'
    WAIT
    !CD..
    CLEA
	 LOOP
ENDIF
IF NAME1#SNAME 
     @23,1 SAY 'THIS BATCH NO AND PRODUCT DO NOT MATCHES'
     WAIT 
     !CD..
     CLEA
  	  LOOP
ENDIF
*PNAME=A->NAME
BSIZE=A->BAT_SIZE
VEXPDATE=A->EXPDATE
VMFGDATE=A->MFGDATE
ROT_SP=A->ROTSP
EXIT
ENDDO
!CD..
DO GRSIPA
DO WHILE .T.
DO PRINTOPT
VGRPA=SPACE(6)
DO WHILE SPAGE<=EPAGE
    VGRPA='GRPA'+LTRIM(STR(SPAGE))
    DO &VGRPA
    SPAGE=SPAGE+1
    IF SPAGE>EPAGE
       EXIT
    ENDIF
ENDDO	
*EJECT
SET PRINT OFF
SET DEVI TO SCREEN
SET PRINTER TO
yn=' '
CLEA
@22,1 SAY 'ENTER [C] TO CONTINUE FOR SINGLE PAGE BMR' GET YN PICT '!'
READ
IF YN='C'
   CLEA
   DO STA_END.PRG
   CLEA
   @22,1 SAY SPACE(78)
   LOOP
ENDIF	
EXIT
ENDDO
RETU