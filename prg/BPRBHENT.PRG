  
    LN=4
DO WHILE .T.
   SET COLOR TO W+/B,W+/R
   @ln,5 say 'BATCH NO            :' GET VBNO PICT 'AA!9999'
   READ
  IF VBNO=SPACE(7)
    RETU
  ENDIF 
  SELE A
*  USE BATCH_NO INDE BNO
  USE BATCH_NO ORDER BNO
   SEEK VBNO
  IF .NOT. FOUND()
    SET COLOR TO W+/G
    @21,2 SAY SPACE(70)
    @21,2 SAY '... BATCH NO NOT FOUND....ENTER BATCHNO AGAIN..PREE ANY KEY..'
    UX=INKEY(0)
    @21,2 SAY SPACE(70)
    SET COLOR TO W+/B,W+/R
    LOOP
 ENDIF
 IF A->NAME1#SNAME 
     SET COLOR TO W+/G
     @21,2 SAY SPACE(70)
     @21,2 SAY '.....THIS BATCH NO. AND PRODUCT DOES  NOT MATCH....'
     SET COLOR TO W+/B,W+/R
     UX=INKEY(0)
     LOOP
ENDIF
BSIZE=A->BAT_SIZE
VEXPDATE=A->EXPDATE
VMFGDATE=A->MFGDATE
ROT_SP=A->ROTSP
EXIT
ENDDO
SELE A
USE

