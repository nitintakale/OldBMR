******CIPLOX BPR  CALCULATION
PUBLIC PG1,PG2,PG3,PG4,PG5,EE,EE1,RM
ee=repli('=',80)
ee1=repli('-',80)
PNAME='CIPLOX EYE/EAR DROPS'
GNAME='(CIPROFLOXACIN HYDROCHLORIDE U.S.P.)'
store 0 to PG1,PG2,PG3,PG4,PG5,RM
RM=BSIZE*1000/VOLVIAL
RM=BSIZE*1000/VOLVIAL
RM=RM-5
RM=ROUND(RM,-1)
PG1=3.04*bsize*1000/1000
PG2=0.97*bsize*1000/1000
PG3=0.97*bsize*1000/1000
PG4=RM/18
PG5=RM/360
