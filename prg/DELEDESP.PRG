****TO DELETE DESPATCHED ORDERS FORM PKG_MST
SELE A
USE \DBASE\BMR\PKG_MST EXCLU
GO TOP
SELE B
USE \DBASE\ADISALE\EXPORT\EXPORT1  EXCLU
SET ORDER TO EX1SRNO
SET FILT TO DESPATCH # "Y"
GO TOP
DO WHILE .NOT. EOF()
    SELE A
    GO TOP
    SET FILT TO CIPORDNO=B->CIPORDNO .AND. ADITICODE=B->ADITICODE .AND. CATEGORY="E"
    GO TOP
IF .NOT. EOF()
    REPL ALL A->SRNO WITH B->SRNO
    BROW
ENDIF
    SELE B
    SKIP
ENDDO   



