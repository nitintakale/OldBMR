@ln,20 say 'LTRS /'
@ln,27 say rm pict '9,99,999'
@LN,35 SAY 'VIALS'
@LN,50 SAY 'MANUAL NO   :'+LTRIM(VMMFNO)
LN=LN+1
@LN,1 SAY 'SERIAL NO    :'
