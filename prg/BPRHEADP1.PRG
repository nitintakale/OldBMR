****PAGE 1 COMMON MATTER
@0,1 say bsize pict '9999'
@0,6 say 'L'
LN=0
ln=ln+1
@LN,0 SAY CHR(27)+"E"
IF VNAME='CIPLA'
	@LN,1 SAY 'CIPLA'
	@LN,40 SAY 'C/O ADITI PHARMACEUTICALS PVT.LTD.'
	LN=LN+1
	@LN,1 SAY 'MUMBAI CENTRAL-400008'
	@LN,45 SAY 'SOLAPUR- 413006'
ENDIF
IF VNAME='ADITI'
	@LN,40 SAY 'ADITI PHARMACEUTICALS PVT.LTD.'
	LN=LN+1
	@LN,45 SAY 'SOLAPUR- 413006'
ENDIF
IF VNAME='OKASA'
	@LN,1 SAY 'OKASA'
	@LN,40 SAY 'C/O ADITI PHARMACEUTICALS PVT.LTD.'
	LN=LN+1
	@LN,1 SAY 'SATARA'
	@LN,45 SAY 'SOLAPUR- 413006'
ENDIF
	LN=LN+1
	@LN,1 SAY EE
LN=LN+1
@LN,1 SAY 'PRODUCT      :'
@ln,15 say pname
@LN,0 SAY CHR(27)+'F'
@LN,55 SAY 'FORMULATION CODE :' 
@LN,75 SAY VFORMU_CODE PICT '!!!!!!!!!!' 
ln=ln+1
@ln,5 say gname
@LN,50 SAY 'VERSION     :' 
@LN,65 SAY VVERSION PICT '!!!!!!!!!!' 
LN=LN+1
@LN,1 SAY 'BATCH NO.    :'
@ln,15 say vbno
@LN,50 SAY 'A.R. NO      : _______________'
LN=LN+1
@LN,1 SAY 'MFG. DATE    :'
IF VAL(SUBSTR(VMFGDATE,5,4))<=2000
	@LN,15 SAY VMFGDATE
    @LN,50 SAY 'EXP. DATE    :'
    @LN,65 SAY VEXPDATE
ENDIF
IF VAL(SUBSTR(VMFGDATE,5,4))>2000
   @LN,15 SAY SUBSTR(VMFGDATE,1,4)+SUBSTR(VMFGDATE,7,2)
   @LN,50 SAY 'EXP. DATE    :'
   @LN,65 SAY SUBSTR(VEXPDATE,1,4)+SUBSTR(VEXPDATE,7,2)
ENDIF
LN=LN+1
@LN,1 SAY 'BATCH COMMENCED ON__________:'
@LN,50 SAY 'BATCH COMPLETED ON________   :'
LN=LN+1
@LN,1 SAY 'BATCH SIZE   :'
