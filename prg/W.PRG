*** TO ENTER IN BATCH_NO FILE FOR BMR FROM WORD STAR
SET PROC TO ADIHEAD
DO ADISTART
set printer to
SELE A
USE WORDBMR
SELE B
USE PRODMAST

mdir=space(2)
close data
DO WHILE .T.
STORE SPACE(6) TO VBATCHNO
	STORE 0 TO VADITICODE,VCONVRATE,VBAT_SIZE,VBAT_QTY
	STORE SPACE(10) TO VCODE
	STORE SPACE(7) TO VCOMPANY
	STORE SPACE(12) TO VNAME1
	STORE SPACE(35) TO VNAME2
	STORE SPACE(8) TO VMFGDATE
	STORE SPACE(8) TO VEXPDATE
	STORE SPACE(1) TO VDIGIT
     define window TEMP1 from 1,1 to 16,60
     activate window temp1
     SELE A
     USE WORDBMR
     GO TOP
     define popup s_list from 1,2 to 16,59 prompt fields RTRIM(STR(ADITICODE))+' '+TRIM(CODE)+ "   " +trim(NAME1)+' '+TRIM(NAME2)   footer "Press [ Go down] [ Go up]  [ENTER] key to Select"   && in window temp 1
     @0,0 get vADITICODE popup s_list
      read valid lastkey() = 13 .OR. LASTKEY()=27
      deactivate window temp
     IF LASTKEY()=27
          retu
       ELSE  
         VADITICODE=A.ADITICODE
         vcode=A.CODE
         VCOMPANY=A.COMPANY
         VNAME1=A.NAME1
         VNAME2=A.NAME2
         VCONVRATE=A.CONVRATE
  		 deactivate window TEMP1         
         IF VCODE=SPACE(10)
            @22,1 SAY SPACE(70)
            @22,1 SAY 'CIPLA CODE IN FILE WORDBMR IS BLANK...ENTRY IS CANCELLED'
            WAIT
            RETU
         ENDIF   
         IF VADITICODE=0
            @22,1 SAY SPACE(70)
            @22,1 SAY 'ADITI CODE IN FILE WORDBMR IS BLANK...ENTRY IS CANCELLED'
            WAIT
            RETU
         ENDIF  

         @23,1 say space(78)
     endif
     CLEA
    @ 0,0,24,78 BOX ''
	@5,5 SAY LTRIM(VNAME1)+TRIM(VNAME2)
	@7,5 SAY 'BATCH NO       :' GET VBATCHNO PICT '!!!!!!'
	READ
    IF VBATCHNO=SPACE(6)
        CLEA
        EXIT
    ENDIF    
		@9,5 SAY 'BATCH SIZE     :' GET VBAT_SIZE PICT '9999.99'
		READ
		@11,5 SAY 'BATCH QUANTITY :' GET VBAT_QTY PICT '9999999'
		READ
		@13,5 SAY 'MFG DATE       :' GET VMFGDATE PICT '!!!.!!!!'
		READ
		@15,5 SAY 'EXP DATE       :' GET VEXPDATE PICT '!!!.!!!!'
		READ

   	VCON=' '
	@23,5 SAY '[C] TO CONFIRM ' GET VCON PICT '!'
	READ
IF VCON='C'
  VDIGIT=LTRIM(VBATCHNO)
  VDIGIT=SUBSTR(VDIGIT,3,1)
  MMDIR='0'+LTRIM(VDIGIT)
  SET PATH TO &MMDIR
  USE BATCH_NO
  SET FILT TO BATCHNO=VBATCHNO
  GO TOP
 IF EOF()
  APPE BLANK
  REPL ADITICODE WITH VADITICODE
  REPL CODE WITH LTRIM(VCODE)
  REPL COMPANY WITH LTRIM(VCOMPANY)
  REPL NAME1 WITH VNAME1
  REPL NAME2 WITH VNAME2
  REPL CONVRATE WITH VCONVRATE
  REPL BATCHNO WITH VBATCHNO
  REPL BAT_SIZE WITH VBAT_SIZE
  REPL BAT_QTY WITH VBAT_QTY
  REPL MFGDATE WITH VMFGDATE
  REPL EXPDATE WITH VEXPDATE
 REPL BPR WITH 'Y'  
ELSE
@17,1 SAY SPACE(70)
@17,1 SAY 'ABOVE BATCH IS ALREADY ENTERED IN BATCH_NO FILE.... UPDATION NOT ALLOWED'
WAIT
ENDIF
ENDIF
ENDDO
