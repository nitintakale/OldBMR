SET EXCLUSIVE ON
CLEA
@ 0,0 to 24,79 double
SET COLO TO G+*/W
@ 10,20 say "Indexing is in progress.. Please wait!!!"
*********
SET COLO TO W+/B,R+/B
CLOSE DATA
USE CBBPR
INDE ON BATCH+CIPORDNO++STR(QUANTITY) TAG BCQ

USE BPRPG
INDE ON TYPE TAG PGTYPE

USE ITEM_MST
INDE ON CODE TAG ITEMCD
INDE ON NAME TAG ITEMNM
INDE ON PKVAL TAG ITEMPK

USE BATCH_NO
INDE ON  NAME1+NAME2 TAG BN12
INDE ON ALLTRIM(BATCHNO) TAG  BNO
INDE ON  NAME1 TAG BN1
INDE ON (NAME1+NAME2)+DTOC(MIX_DATE) TAG BATCH_NO


USE MAINCODE
INDE ON ALLTRIM(UPPER(COMPANY)) TAG MCOMP
INDE ON ALLTRIM(UPPER(COMPANY)) TAG MAINCODE
INDE ON UPPER(MAINNAME) TAG MNAME

USE EXP_DATE
INDE ON CMONTH TAG CEXPMON

USE PRODMAST
INDE ON NAME1+NAME2+COMPANY TAG CPPN12
INDE ON NAME1+NAME2 TAG PN12
INDE ON ADITICODE TAG ADIPROD
SET UNIQUE ON
INDE ON GEN_NAME+NAME1+NAME2 TAG GENMAST
INDE ON GEN_NAME TAG PRODGEN
SET UNIQUE OFF

USE PACKQTY
inde on code+ALLTRIM(batchno) tAG pack_qty
INDE ON BATCHNO TO PACKBT
inde on ADITIcode tAG packCD
SET UNIQUE ON
inde on ADITIcode tAG CDUNI
SET UNIQUE OFF

USE PKG_MST
INDE ON CIPORDNO+ALLTRIM(CODE) TAG ORDCD
INDE ON ALLTRIM(NAME1)+ALLTRIM(NAME2)+ITEM TAG ITEMPKG
INDE ON SRNO TAG PKGSR
SET UNIQUE ON
INDE ON NAME1+NAME2+BATCH+STR(QUANTITY)+CATEGORY+CIPORDNO TAG N12BTQ
INDE ON NAME1+NAME2+BATCH+STR(QUANTITY)+CATEGORY TAG UNIBQC
INDE ON STATUS+ITEM+CODE TAG UNIPK
INDE ON ALLTRIM(BATCH) TAG PKGBAT
INDE ON CIPORDNO+ALLTRIM(BATCH) TAG ORDBAT
SET UNIQUE OFF
INDE ON NAME1+NAME2+BATCH+STR(QUANTITY)+CATEGORY TAG N12BQC


USE STOREBPR
INDE ON BPRSRNO TAG STORESR
SET UNIQUE ON
INDE ON NAME1+NAME2+BATCH+CIPORDNO+ITEM  TAG SISTORE
INDE ON BPRSRNO TO UNISR
SET UNIQUE OFF

use bprdata
inde on bprsrno tag datasr
SET UNIQUE ON
INDE ON CIPORDNO+ALLTRIM(BATCHNO) TAG BPRORDBAT
SET UNIQUE OFF

CLOSE DATA
SET EXCLUSIVE OFF
RETURN