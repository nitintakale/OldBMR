EJECT
LN=0
LN=PROW()
@LN,65 SAY 'PAGE 1 OF 4'
LN=LN+1
@ln,10 say 'CHECKLIST FOR LINE CLEARANCE IN PACKING DEPT.'
LN=LN+2
@LN,3 SAY 'DATE:    '
@LN,50 SAY 'PREVIOUS PRODUCT:'
LN=LN+2
@LN,3 SAY 'PRODUCT: '+LTRIM(PNAME)
@LN,50 SAY 'PREVIOUS BATCH NO:'
LN=LN+2
IF SA_EX='P'
   @LN,3 SAY 'BATCH NO: '+LTRIM(VBNO)+'     [P.S.]'
ENDIF
IF SA_EX='E'
   @LN,3 SAY 'BATCH NO: '+LTRIM(VBNO)+'   [EXPORT]'
ENDIF
IF SA_EX='S'
   @LN,3 SAY 'BATCH NO: '+LTRIM(VBNO)+'   [SALE]'
ENDIF
LN=LN+1